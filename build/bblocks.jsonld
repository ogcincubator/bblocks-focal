      "sourceSchema": "https://ogcincubator.github.io/bblocks-focal/_sources/myFeatureCollection/schema.yaml",
      "ldContext": {
        "prof:hasArtifact": "https://ogcincubator.github.io/bblocks-focal/build/annotated/focal/myFeatureCollection/context.jsonld",
