focal-koppen:Cfa a skos:Concept ;
    skos:broader focal-koppen:C ;
    skos:inScheme focal-koppen:scheme ;
    skos:notation "Cfa" ;
    skos:prefLabel "Temperate, no dry season, hot summer"@en .

focal-koppen:Cfb a skos:Concept ;
