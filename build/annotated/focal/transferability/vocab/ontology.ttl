@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix focal-action: <https://w3id.org/ogc/hosted/focal/transferability/actions/> .
@prefix focal-arole: <https://w3id.org/ogc/hosted/focal/transferability/artifact-roles/> .
@prefix focal-axis: <https://w3id.org/ogc/hosted/focal/transferability/axes/> .
@prefix focal-cls: <https://w3id.org/ogc/hosted/focal/transferability/classification-schemes/> .
@prefix focal-compute: <https://w3id.org/ogc/hosted/focal/transferability/computation-types/> .
@prefix focal-dim: <https://w3id.org/ogc/hosted/focal/transferability/dimensions/> .
@prefix focal-grid: <https://w3id.org/ogc/hosted/focal/transferability/grid-types/> .
@prefix focal-koppen: <https://w3id.org/ogc/hosted/focal/transferability/koppen-geiger/> .
@prefix focal-marker: <https://w3id.org/ogc/hosted/focal/transferability/scenario-markers/> .
@prefix focal-maturity: <https://w3id.org/ogc/hosted/focal/transferability/maturity-statuses/> .
@prefix focal-prop: <https://w3id.org/ogc/hosted/focal/transferability/properties/> .
@prefix focal-qdim: <https://w3id.org/ogc/hosted/focal/transferability/quality-dimensions/> .
@prefix focal-role: <https://w3id.org/ogc/hosted/focal/transferability/roles/> .
@prefix focal-test: <https://w3id.org/ogc/hosted/focal/transferability/tests/> .
@prefix focal-transf: <https://w3id.org/ogc/hosted/focal/transferability/> .
@prefix focal-trigger: <https://w3id.org/ogc/hosted/focal/transferability/triggers/> .
@prefix geof: <http://www.opengis.net/def/function/geosparql/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

focal-koppen:Af a skos:Concept ;
    skos:broader focal-koppen:A ;
    skos:inScheme focal-koppen:scheme ;
    skos:notation "Af" ;
    skos:prefLabel "Tropical rainforest"@en .

