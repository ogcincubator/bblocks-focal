{"defs":{},"properties":[{"path":["_oneOf"],"sources":["bblocks://ogc.focal.transferability.temporalExtent"],"keyword":"oneOf"},{"path":["_oneOf","0"],"title":"Calendar interval","sources":["bblocks://ogc.focal.transferability.temporalExtent"],"keyword":"branch"},{"path":["_oneOf","0","start"],"id":"https://w3id.org/ogc/hosted/focal/transferability/properties/start","description":"Start of the interval. Granularity is workflow-specific (a date, a year, a multi-year period) and not constrained here.\n","required":true,"schema_type":"string","sources":["bblocks://ogc.focal.transferability.temporalExtent"],"effectiveId":"https://w3id.org/ogc/hosted/focal/transferability/properties/start"},{"path":["_oneOf","0","end"],"id":"https://w3id.org/ogc/hosted/focal/transferability/properties/end","description":"End of the interval, same granularity as `start`.","required":true,"schema_type":"string","sources":["bblocks://ogc.focal.transferability.temporalExtent"],"effectiveId":"https://w3id.org/ogc/hosted/focal/transferability/properties/end"},{"path":["_oneOf","1"],"title":"Scenario-indexed marker","sources":["bblocks://ogc.focal.transferability.temporalExtent"],"keyword":"branch"},{"path":["_oneOf","1","scenarioMarker"],"id":"https://w3id.org/ogc/hosted/focal/transferability/properties/scenarioMarker","description":"A non-calendar, scenario-indexed temporal position (e.g. a Global Warming Level label) where no calendar interval can be stated. See the description above for the pending UP-WF1 owner review before treating any specific value here as settled.\n","required":true,"schema_type":"string","sources":["bblocks://ogc.focal.transferability.temporalExtent"],"effectiveId":"https://w3id.org/ogc/hosted/focal/transferability/properties/scenarioMarker"}]}