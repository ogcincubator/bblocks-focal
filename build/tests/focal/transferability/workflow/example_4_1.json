      "run": "#hotspot_characterization.cwl",
      "in": {
        "hotspots": "hotspot_detection/hotspot_map",
        "clms": "clms_tcd_imd",
        "lcz": "lcz_data"
      },
      "out": [
        "characterized_map"
      ]
    }
  },
