{
  "class": "Workflow",
  "id": "",
  "cwlVersion": "v1.2",
  "label": "UP-WF2 \u2014 Urban hot/cool spot",
  "requirements": {
    "SoftwareRequirement": {
      "packages": [
        {
          "package": "python",
          "version": [
            "3.10"
          ]
        },
        {
          "package": "rioxarray"
        },
        {
          "package": "xarray"
        },
        {
          "package": "rasterio"
        },
        {
          "package": "geopandas"
