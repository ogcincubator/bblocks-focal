    "artifactRules": [
      {
        "artifact": "trained tree growth model (LightGBM, Czech permanent sample plot data)",
        "artifactRole": "workflow-output",
        "artifactRef": "outputs.trained_growth_model",
        "rules": [
          {
            "triggeredBy": "different-ecological-range",
