{
  "@context": "https://ogcincubator.github.io/bblocks-focal/build/annotated/focal/transferability/rule/context.jsonld",
  "appliesTo": [
    "growth-model"
  ],
  "when": [
    {
      "constraint": "ecological-range",
      "test": "outside"
    }
  ],
  "actions": [
    "retrain",
    "replace-with-alternative-published-model"
  ],
  "mandatory": true
}