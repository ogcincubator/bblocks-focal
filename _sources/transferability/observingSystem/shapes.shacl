@prefix sh:          <http://www.w3.org/ns/shacl#> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .
@prefix focal-prop:  <https://w3id.org/ogc/hosted/focal/transferability/properties/> .
@prefix focal-shape: <https://w3id.org/ogc/hosted/focal/transferability/shapes/> .

#################################################################
# Shapes for what a transferability statement is attached to when that thing is an observing
# system. Everything about the statement itself (envelope, artifacts, rules, referential integrity)
# lives in transferabilityStatement and is inherited through dependsOn; nothing is repeated here.
#
# Deliberately no shape requires maturityStatus, unlike the workflow block: no source has stated
# one for an observing system.
#################################################################

focal-shape:ObservingSystem
  a sh:NodeShape ;
  sh:severity sh:Violation ;
  sh:targetSubjectsOf focal-prop:transferability ;

  sh:property [
    sh:path focal-prop:transferability ;
    sh:name "transferability" ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "an observing system carries exactly one transferability statement. Two would be two different claims about where the same system's results are valid." ;
  ] ;

  sh:property [
    sh:path rdfs:label ;
    sh:name "label" ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
    sh:message "a label, where given, is one non-empty string, in the words of the source." ;
  ] ;
.
