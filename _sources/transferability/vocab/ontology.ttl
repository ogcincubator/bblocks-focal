@prefix focal-action: <https://w3id.org/ogc/hosted/focal/transferability/actions/> .
@prefix focal-trigger: <https://w3id.org/ogc/hosted/focal/transferability/triggers/> .
@prefix focal-dim: <https://w3id.org/ogc/hosted/focal/transferability/dimensions/> .
@prefix focal-role: <https://w3id.org/ogc/hosted/focal/transferability/roles/> .
@prefix focal-compute: <https://w3id.org/ogc/hosted/focal/transferability/computation-types/> .
@prefix focal-maturity: <https://w3id.org/ogc/hosted/focal/transferability/maturity-statuses/> .
@prefix focal-qdim: <https://w3id.org/ogc/hosted/focal/transferability/quality-dimensions/> .
@prefix focal-arole: <https://w3id.org/ogc/hosted/focal/transferability/artifact-roles/> .
@prefix focal-transf: <https://w3id.org/ogc/hosted/focal/transferability/> .
@prefix focal-prop: <https://w3id.org/ogc/hosted/focal/transferability/properties/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix geof: <http://www.opengis.net/def/function/geosparql/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix focal-test: <https://w3id.org/ogc/hosted/focal/transferability/tests/> .
@prefix focal-marker: <https://w3id.org/ogc/hosted/focal/transferability/scenario-markers/> .
@prefix focal-grid: <https://w3id.org/ogc/hosted/focal/transferability/grid-types/> .
@prefix focal-axis: <https://w3id.org/ogc/hosted/focal/transferability/axes/> .
@prefix focal-cls: <https://w3id.org/ogc/hosted/focal/transferability/classification-schemes/> .
@prefix focal-koppen: <https://w3id.org/ogc/hosted/focal/transferability/koppen-geiger/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .

#################################################################
# transferabilityAction
#################################################################

focal-action:scheme a skos:ConceptScheme ;
  skos:prefLabel "FOCAL Transferability Actions"@en ;
  skos:definition "What must be done to a reference or calibration artifact to make it valid outside a workflow's original validity envelope."@en ;
  skos:hasTopConcept
    focal-action:reuse-as-is, focal-action:replace-with-local-equivalent,
    focal-action:retrain, focal-action:replace-with-alternative-published-model,
    focal-action:component-not-executable ;
.

focal-action:reuse-as-is a skos:Concept ;
  skos:prefLabel "reuse as-is"@en ;
  skos:definition "The artifact is valid unchanged for the target; no adaptation needed."@en ;
  skos:topConceptOf focal-action:scheme ;
  skos:inScheme focal-action:scheme ;
.

focal-action:replace-with-local-equivalent a skos:Concept ;
  skos:prefLabel "replace with local equivalent"@en ;
  skos:definition "Swap the artifact for an equivalent one representative of the target (e.g. local reference data, a local classification scheme)."@en ;
  skos:topConceptOf focal-action:scheme ;
  skos:inScheme focal-action:scheme ;
.

focal-action:retrain a skos:Concept ;
  skos:prefLabel "retrain"@en ;
  skos:definition "Retrain or recalibrate a machine-learning artifact against data representative of the target. Mandatoriness is not implied by the term itself — see the `mandatory` property on transferability/rule."@en ;
  skos:topConceptOf focal-action:scheme ;
  skos:inScheme focal-action:scheme ;
.

focal-action:replace-with-alternative-published-model a skos:Concept ;
  skos:prefLabel "replace with alternative published model"@en ;
  skos:definition "Substitute a different, already-published model with parameters valid for the target, as an alternative to retraining the original."@en ;
  skos:topConceptOf focal-action:scheme ;
  skos:inScheme focal-action:scheme ;
.

focal-action:component-not-executable a skos:Concept ;
  skos:prefLabel "component not executable"@en ;
  skos:definition "No substitute is available for the target; the affected workflow component cannot currently be run outside its original footprint. A terminal, non-actionable outcome."@en ;
  skos:topConceptOf focal-action:scheme ;
  skos:inScheme focal-action:scheme ;
.

#################################################################
# triggeredBy
#################################################################

focal-trigger:scheme a skos:ConceptScheme ;
  skos:prefLabel "FOCAL Transferability Triggers"@en ;
  skos:definition "The condition, evaluated against a workflow's validity envelope, that triggers a transferability rule."@en ;
  skos:hasTopConcept
    focal-trigger:different-geographic-coverage, focal-trigger:different-ecological-range,
    focal-trigger:different-climate-regime, focal-trigger:different-dataset ;
.

focal-trigger:different-geographic-coverage a skos:Concept ;
  skos:prefLabel "different geographic coverage"@en ;
  skos:definition "The target falls outside the geographic/administrative coverage the artifact was built or is available for — including a hard dataset-footprint boundary (e.g. a pan-European dataset outside Europe). Whether this is resolvable is carried by the paired action (replace-with-local-equivalent vs. component-not-executable), not by a separate trigger value."@en ;
  skos:topConceptOf focal-trigger:scheme ;
  skos:inScheme focal-trigger:scheme ;
.

focal-trigger:different-ecological-range a skos:Concept ;
  skos:prefLabel "different ecological range"@en ;
  skos:definition "The target falls outside the ecological range (e.g. forest type, species composition, phenology) the artifact was calibrated for."@en ;
  skos:topConceptOf focal-trigger:scheme ;
  skos:inScheme focal-trigger:scheme ;
.

focal-trigger:different-climate-regime a skos:Concept ;
  skos:prefLabel "different climate regime"@en ;
  skos:definition "The target has a different climate regime (e.g. Köppen-Geiger class) than the artifact was derived for."@en ;
  skos:topConceptOf focal-trigger:scheme ;
  skos:inScheme focal-trigger:scheme ;
.

focal-trigger:different-dataset a skos:Concept ;
  skos:prefLabel "different dataset"@en ;
  skos:definition "The target requires a structurally different source dataset (e.g. different variable, unit, time axis, or grid) than the one the artifact was built against."@en ;
  skos:topConceptOf focal-trigger:scheme ;
  skos:inScheme focal-trigger:scheme ;
.

#################################################################
# envelope dimensions (open, deliberately seeded small)
#################################################################

focal-dim:scheme a skos:ConceptScheme ;
  skos:prefLabel "FOCAL Transferability Envelope Dimensions"@en ;
  skos:definition "The axes along which a workflow's validity envelope is stated. Deliberately seeded small and open to growth — not a closed set."@en ;
  skos:hasTopConcept
    focal-dim:spatial, focal-dim:ecological, focal-dim:climatic, focal-dim:jurisdictional,
    focal-dim:temporal, focal-dim:grid-structure ;
.

focal-dim:spatial a skos:Concept ;
  skos:prefLabel "spatial"@en ;
  skos:definition "Geographic location or extent."@en ;
  skos:topConceptOf focal-dim:scheme ;
  skos:inScheme focal-dim:scheme ;
.

focal-dim:ecological a skos:Concept ;
  skos:prefLabel "ecological"@en ;
  skos:definition "Ecological range: forest type, species composition, phenology, and similar."@en ;
  skos:topConceptOf focal-dim:scheme ;
  skos:inScheme focal-dim:scheme ;
.

focal-dim:climatic a skos:Concept ;
  skos:prefLabel "climatic"@en ;
  skos:definition "Climate regime or classification (e.g. Köppen-Geiger, Quitt zones)."@en ;
  skos:topConceptOf focal-dim:scheme ;
  skos:inScheme focal-dim:scheme ;
.

focal-dim:jurisdictional a skos:Concept ;
  skos:prefLabel "jurisdictional"@en ;
  skos:definition "Administrative or licensing boundary (e.g. data only licensed for use in one country)."@en ;
  skos:topConceptOf focal-dim:scheme ;
  skos:inScheme focal-dim:scheme ;
.

focal-dim:temporal a skos:Concept ;
  skos:prefLabel "temporal"@en ;
  skos:definition "The calendar span, or non-calendar scenario marker (e.g. a Global Warming Level), over which results are valid."@en ;
  skos:topConceptOf focal-dim:scheme ;
  skos:inScheme focal-dim:scheme ;
.

# Evidenced by UP-WF3 (its rotated-pole versus regular lat/lon grid split), by FP-WF2/FP-WF5's
# grid-resolution and interpolation settings, and by UP-WF3's NUTS3 vulnerability index being
# "coarser than the precipitation grid and not aligned with the AOI boundary". Distinct from
# `spatial`, which says where results are valid, not how the inputs have to be gridded: a workflow
# can be valid across the whole of Europe and still refuse anything that is not on its grid.
focal-dim:grid-structure a skos:Concept ;
  skos:prefLabel "grid structure"@en ;
  skos:definition "How the workflow's inputs must be gridded, as opposed to where they are: projection family (e.g. rotated pole versus regular lat/lon), spatial resolution, and grid alignment."@en ;
  skos:topConceptOf focal-dim:scheme ;
  skos:inScheme focal-dim:scheme ;
.

#################################################################
# envelope roles
#################################################################

focal-role:scheme a skos:ConceptScheme ;
  skos:prefLabel "FOCAL Transferability Envelope Roles"@en ;
  skos:definition "The role an envelope statement plays, independent of which dimension it concerns. A workflow can carry more than one role for the same or different dimensions at once — e.g. trained-on/spatial, valid-for/ecological, and can-run-on/climatic can all apply simultaneously to one workflow."@en ;
  skos:hasTopConcept
    focal-role:trained-on, focal-role:valid-for, focal-role:can-run-on ;
.

focal-role:trained-on a skos:Concept ;
  skos:prefLabel "trained on"@en ;
  skos:definition "What the artifact was trained or calibrated on."@en ;
  skos:topConceptOf focal-role:scheme ;
  skos:inScheme focal-role:scheme ;
.

focal-role:valid-for a skos:Concept ;
  skos:prefLabel "valid for"@en ;
  skos:definition "The range within which the artifact's outputs are considered valid. Often not a geometry at all — may be expressed in a non-spatial dimension (e.g. an ecological range)."@en ;
  skos:topConceptOf focal-role:scheme ;
  skos:inScheme focal-role:scheme ;
.

focal-role:can-run-on a skos:Concept ;
  skos:prefLabel "can run on"@en ;
  skos:definition "Where the workflow can technically be executed, independent of whether its outputs are valid there."@en ;
  skos:topConceptOf focal-role:scheme ;
  skos:inScheme focal-role:scheme ;
.

#################################################################
# computationType
#################################################################

focal-compute:scheme a skos:ConceptScheme ;
  skos:prefLabel "FOCAL Computation Types"@en ;
  skos:definition "How a workflow computes its results. Optional at the workflow level — omitted entirely for workflows that aren't an executable Application/ApplicationPackage at all (e.g. an observing system), not a fourth 'not applicable' value."@en ;
  skos:hasTopConcept
    focal-compute:statistical-ml, focal-compute:deterministic-rule-based,
    focal-compute:precomputed-delivery ;
.

focal-compute:statistical-ml a skos:Concept ;
  skos:prefLabel "statistical/ML"@en ;
  skos:definition "Results come from a statistical or machine-learning model (e.g. a trained regression, LightGBM, an EO time-series classifier)."@en ;
  skos:topConceptOf focal-compute:scheme ;
  skos:inScheme focal-compute:scheme ;
.

focal-compute:deterministic-rule-based a skos:Concept ;
  skos:prefLabel "deterministic/rule-based"@en ;
  skos:definition "Results come from a fixed deterministic calculation or rule set (e.g. threshold exceedance, rolling accumulation), with no learned parameters."@en ;
  skos:topConceptOf focal-compute:scheme ;
  skos:inScheme focal-compute:scheme ;
.

focal-compute:precomputed-delivery a skos:Concept ;
  skos:prefLabel "precomputed data delivery"@en ;
  skos:definition "The workflow delivers a dataset computed elsewhere in advance; there is no re-executable process, only data access. The motivating case is UP-WF1's NUKLEUS ensemble delivery."@en ;
  skos:topConceptOf focal-compute:scheme ;
  skos:inScheme focal-compute:scheme ;
.

#################################################################
# maturityStatus
#################################################################

focal-maturity:scheme a skos:ConceptScheme ;
  skos:prefLabel "FOCAL Workflow Maturity Statuses"@en ;
  skos:definition "The operational maturity of a FOCAL pilot workflow itself, as distinct from a bblock's own authoring-lifecycle status (bblock.json's `status` field: under-development/experimental/stable/...). Deliberately a separate vocabulary in different words to avoid two unrelated axes sharing identical string values on the same object graph."@en ;
  skos:hasTopConcept
    focal-maturity:prototype, focal-maturity:pre-operational, focal-maturity:operational ;
.

focal-maturity:prototype a skos:Concept ;
  skos:prefLabel "prototype"@en ;
  skos:definition "Not yet operationally mature; full regression testing/validation is not complete (e.g. FP-WF3)."@en ;
  skos:topConceptOf focal-maturity:scheme ;
  skos:inScheme focal-maturity:scheme ;
.

focal-maturity:pre-operational a skos:Concept ;
  skos:prefLabel "pre-operational"@en ;
  skos:definition "Shared for integration testing but not yet integrated into the operational platform — a genuine intermediate state between prototype and operational (e.g. UP-WF3)."@en ;
  skos:topConceptOf focal-maturity:scheme ;
  skos:inScheme focal-maturity:scheme ;
.

focal-maturity:operational a skos:Concept ;
  skos:prefLabel "operational"@en ;
  skos:definition "Running and integrated. Says nothing about result confidence on its own — see transferability/qualityAnnotation for caveats such as FP-WF1's 'decision-support, not exact' note, which does not change a workflow's maturity stage."@en ;
  skos:topConceptOf focal-maturity:scheme ;
  skos:inScheme focal-maturity:scheme ;
.

#################################################################
# qualityAnnotation dimensions
#
# Typed as both skos:Concept (this vocabulary's own membership) and dqv:Dimension (W3C Data
# Quality Vocabulary) -- there is no OGC Block wrapping DQV to depend on (checked 2026-09-02:
# no register or bblock anywhere defines DQV; the only other DQV usage in the bblocks ecosystem
# is ogc.hosted.iliad.api.features.indicator-quality-requirement, a Tier-3 sibling with different
# domain semantics), so these concepts bind straight to the published DQV namespace instead.
#################################################################

focal-qdim:scheme a skos:ConceptScheme ;
  skos:prefLabel "FOCAL Quality Annotation Dimensions"@en ;
  skos:definition "Dimensions along which a qualityAnnotation statement expresses uncertainty or confidence about a workflow's results, independent of its maturityStatus. Deliberately seeded small from a single workflow (FP-WF1) and open to growth."@en ;
  skos:hasTopConcept
    focal-qdim:decision-support-only, focal-qdim:validation-incomplete,
    focal-qdim:spatial-support-mismatch ;
.

focal-qdim:decision-support-only a skos:Concept, dqv:Dimension ;
  skos:prefLabel "decision-support only"@en ;
  skos:definition "Results are intended to inform a decision rather than stand as an exact forecast or measurement (e.g. FP-WF1's AI model output)."@en ;
  dqv:inCategory focal-qdim:scheme ;
  skos:topConceptOf focal-qdim:scheme ;
  skos:inScheme focal-qdim:scheme ;
.

focal-qdim:validation-incomplete a skos:Concept, dqv:Dimension ;
  skos:prefLabel "validation incomplete"@en ;
  skos:definition "Model or validation work is still being finalised at the time of the statement."@en ;
  dqv:inCategory focal-qdim:scheme ;
  skos:topConceptOf focal-qdim:scheme ;
  skos:inScheme focal-qdim:scheme ;
.

focal-qdim:spatial-support-mismatch a skos:Concept, dqv:Dimension ;
  skos:prefLabel "spatial support mismatch"@en ;
  skos:definition "Two or more of the workflow's inputs are on supports of different resolution, or on supports that do not align, so results combining them are coarser or less precisely located than the finest input suggests. A property of the workflow as deployed, not of a transfer: it holds in the source region too."@en ;
  skos:scopeNote "Bears on how far a result can be read, not on whether the workflow can move. Use an envelope constraint, not this dimension, when the issue is that a target falls outside a boundary."@en ;
  dqv:inCategory focal-qdim:scheme ;
  skos:topConceptOf focal-qdim:scheme ;
  skos:inScheme focal-qdim:scheme ;
.

#################################################################
# artifactRole
#
# Open, like every other scheme here. Previously a closed JSON Schema enum, which was the one
# place the model contradicted its own open-vocabulary stance -- and, being the newest and
# least-evidenced field, the one most likely to need a fifth value.
#################################################################

focal-arole:scheme a skos:ConceptScheme ;
  skos:prefLabel "FOCAL Transferability Artifact Roles"@en ;
  skos:definition "What kind of thing a reference or calibration artifact is, independent of whether an executable workflow description exists that could give it an identifier yet."@en ;
  skos:hasTopConcept
    focal-arole:workflow-input, focal-arole:workflow-output,
    focal-arole:external-resource, focal-arole:infrastructure ;
.

focal-arole:workflow-input a skos:Concept ;
  skos:prefLabel "workflow input"@en ;
  skos:definition "Consumed as an input of the workflow: a configuration file, a parameter, or a reference dataset."@en ;
  skos:topConceptOf focal-arole:scheme ;
  skos:inScheme focal-arole:scheme ;
.

focal-arole:workflow-output a skos:Concept ;
  skos:prefLabel "workflow output"@en ;
  skos:definition "Produced by (a step of) the workflow and reused as an input elsewhere -- a trained model, for example."@en ;
  skos:topConceptOf focal-arole:scheme ;
  skos:inScheme focal-arole:scheme ;
.

focal-arole:external-resource a skos:Concept ;
  skos:prefLabel "external resource"@en ;
  skos:definition "Referenced by the workflow's documentation but not wired into its executable description -- an optional validation dataset, for example."@en ;
  skos:topConceptOf focal-arole:scheme ;
  skos:inScheme focal-arole:scheme ;
.

focal-arole:infrastructure a skos:Concept ;
  skos:prefLabel "infrastructure"@en ;
  skos:definition "Physical or operational, not data at all -- a sensor network that must be re-deployed rather than replaced."@en ;
  skos:topConceptOf focal-arole:scheme ;
  skos:inScheme focal-arole:scheme ;
.

#################################################################
# condition tests
#
# How a target is compared against an envelope constraint. Two terms, because the only question a
# rule ever asks of a constraint is whether the target falls within it or not -- but they are
# concepts rather than a JSON enum, so each can say how it is actually evaluated per dimension.
#
# That is what makes the model assessable rather than merely readable: for a spatial constraint,
# `inside` is geof:sfWithin against the constraint's geometry, and a GeoSPARQL engine can compute
# it. For an ecological constraint whose value is prose, the same term means a human judgement.
# Same rule structure either way; the dimension decides whether a machine can settle it.
#################################################################

focal-test:scheme a skos:ConceptScheme ;
  skos:prefLabel "FOCAL Envelope Condition Tests"@en ;
  skos:definition "How a target is tested against an envelope constraint when deciding whether a transferability rule fires."@en ;
  skos:hasTopConcept focal-test:inside, focal-test:outside,
    focal-test:same-class-as, focal-test:different-class-from ;
.

focal-test:inside a skos:Concept ;
  skos:prefLabel "inside"@en ;
  skos:definition "The target falls wholly within the constraint. For a spatial, jurisdictional or grid-structure constraint this is evaluable -- geof:sfWithin against the constraint's geometry, or set membership against its accepted grid types; for a temporal constraint, containment in the stated period; for a prose-valued dimension it is a human judgement stated in the same terms."@en ;
  rdfs:seeAlso geof:sfWithin ;
  skos:topConceptOf focal-test:scheme ;
  skos:inScheme focal-test:scheme ;
.

# `outside` is the strict negation of `inside`, NOT geo:sfDisjoint. The two differ on exactly the
# case that matters most in practice: an area of interest that partly overlaps a coverage is
# neither wholly within it nor disjoint from it, and almost every real European AOI straddles some
# boundary. Reading `outside` as sfDisjoint would silently answer "no rule fires" for a target
# half of which the workflow cannot serve. Reading it as NOT sfWithin flags that target, which is
# the conservative direction and the one every other approximation in this model already leans.
focal-test:outside a skos:Concept ;
  skos:prefLabel "outside"@en ;
  skos:definition "The target does not fall wholly within the constraint: the strict negation of focal-test:inside, and the condition under which almost every evidenced FOCAL rule fires. A target that partly overlaps the constraint is outside it, not disjoint from it -- partial overlap means the workflow cannot serve the whole target, so the rule fires. Evaluable for a spatial constraint as NOT geof:sfWithin, which is deliberately not geof:sfDisjoint."@en ;
  rdfs:seeAlso geof:sfWithin ;
  skos:topConceptOf focal-test:scheme ;
  skos:inScheme focal-test:scheme ;
.

# `same-class-as`/`different-class-from` test a constraint whose value names a classification
# scheme and a reference, rather than a value the target is compared against directly. The claim
# they encode is *analogy*, not containment: FP-WF1's "valid mainly within a comparable ecological
# range" says the target must resemble the training area, and says nothing about which classes the
# training area happens to fall in. Enumerating those classes would state something the source
# never said and would go stale the moment the training geometry is corrected. Naming the relation
# instead keeps the claim exactly as strong as the sentence it came from, and lets the class set be
# derived from whatever geometry the reference constraint currently holds.
focal-test:same-class-as a skos:Concept ;
  skos:prefLabel "same class as"@en ;
  skos:definition "The target falls in the same class of the constraint's classification scheme as the constraint's reference does. Evaluable wherever the scheme is: classify the reference (usually a geometry held by another constraint in the same envelope), classify the target, and compare. Where the constraint states its classes explicitly instead of naming a reference, this is set membership."@en ;
  skos:scopeNote "For a claim of resemblance, not of location. Use focal-test:inside when the constraint is an extent the target must fall within."@en ;
  skos:topConceptOf focal-test:scheme ;
  skos:inScheme focal-test:scheme ;
.

focal-test:different-class-from a skos:Concept ;
  skos:prefLabel "different class from"@en ;
  skos:definition "The strict negation of focal-test:same-class-as, and the condition under which an analogy rule fires. A target spanning several classes, only some of which the reference shares, is different from it -- the same conservative reading that makes focal-test:outside the negation of focal-test:inside rather than disjointness."@en ;
  skos:topConceptOf focal-test:scheme ;
  skos:inScheme focal-test:scheme ;
.

#################################################################
# classification-schemes
#
# The published classification systems a `same-class-as` constraint may be evaluated in. FOCAL
# names the scheme; it does not restate the scheme's terms. That is the same discipline applied to
# QUDT units, DQV dimensions and CF grid mappings, and it matters more here than anywhere else,
# because these schemes are asymmetric in how referenceable they are:
#
#   - EUNIS habitats is a real SKOS vocabulary, published by the EEA in the EIONET data dictionary
#     with skos:broader/narrower/exactMatch, and mirrored as an INSPIRE codelist. Individual
#     habitat classes have dereferenceable URIs and should be used as such.
#   - Koppen-Geiger had no term URIs at all: it is published as datasets (the Beck et al. 1-km
#     rasters, with DOIs), not as a vocabulary. FOCAL publishes them, in focal-koppen:scheme.
#
# The rule is not "never mint". It is **never fork a vocabulary that has a maintainer**. Restating
# EUNIS would create a second, diverging copy of something the EEA curates, which is the failure
# this discipline exists to prevent. Koppen-Geiger has no maintainer to diverge from and a closed,
# decades-stable class set, so giving it identifiers fills a gap instead of competing with one.
# Publishing it is a contribution, and it is published here, under FOCAL identifiers.
#
# `same-class-as` remains the preferred form regardless, because it tracks what the sources
# actually say: FP-WF1 claims resemblance to where it was calibrated and names no class. A
# constraint naming a reference never has to identify a class at all, which is also what let this
# model use Koppen before the terms existed.
#################################################################

focal-cls:scheme a skos:ConceptScheme ;
  skos:prefLabel "FOCAL Classification Schemes"@en ;
  skos:definition "Published classification systems in which an envelope constraint's analogy test may be evaluated. Open, and deliberately shallow: each concept identifies an external scheme and says where its terms live, rather than reproducing them."@en ;
  skos:hasTopConcept focal-cls:eunis-habitats, focal-cls:koppen-geiger,
    focal-cls:eea-biogeographical-regions ;
.

focal-cls:eunis-habitats a skos:Concept ;
  skos:prefLabel "EUNIS habitat classification"@en ;
  skos:definition "The European Nature Information System hierarchical habitat classification, maintained by the European Environment Agency. Terms are dereferenceable and should be cited by their own URIs where a constraint states classes explicitly."@en ;
  skos:notation "eunis-habitats" ;
  rdfs:seeAlso <https://eunis.eea.europa.eu/about> ;
  focal-prop:termNamespace <http://eunis.eea.europa.eu/eunishabitats/> ;
  skos:relatedMatch <http://inspire.ec.europa.eu/codelist/EunisHabitatTypeCodeValue/> ;
  skos:topConceptOf focal-cls:scheme ;
  skos:inScheme focal-cls:scheme ;
.

focal-cls:koppen-geiger a skos:Concept ;
  skos:prefLabel "Koppen-Geiger climate classification"@en ;
  skos:definition "The Koppen-Geiger empirical climate classification, in its modern high-resolution form. Classes are the conventional letter codes (Cfb, Dfb, ...)."@en ;
  skos:notation "koppen-geiger" ;
  skos:scopeNote "No maintainer publishes this scheme as a vocabulary, so FOCAL does: focal-prop:termNamespace points at the 30 classes and their five parent groups, given identifiers here and defined in focal-koppen:scheme. The classes are long-established and not FOCAL's; only their IRIs are. Naming a reference via focal-prop:sameClassAs remains the preferred form where the source states an analogy rather than a class."@en ;
  dcterms:source <https://doi.org/10.1038/sdata.2018.214> ;
  focal-prop:termNamespace <https://w3id.org/ogc/hosted/focal/transferability/koppen-geiger/> ;
  skos:related focal-koppen:scheme ;
  skos:topConceptOf focal-cls:scheme ;
  skos:inScheme focal-cls:scheme ;
.

focal-cls:eea-biogeographical-regions a skos:Concept ;
  skos:prefLabel "EEA biogeographical regions"@en ;
  skos:definition "The European Environment Agency's biogeographical regions of Europe (Alpine, Atlantic, Continental, Pannonian, ...), used under the Habitats Directive."@en ;
  skos:notation "eea-biogeographical-regions" ;
  rdfs:seeAlso <https://www.eea.europa.eu/en/datahub/datahubitem-view/11db8d14-f167-4cd5-9205-95638dfd9618> ;
  skos:topConceptOf focal-cls:scheme ;
  skos:inScheme focal-cls:scheme ;
.

#################################################################
# grid types
#
# The value vocabulary for a `grid-structure` envelope constraint. UP-WF3 is the evidenced case:
# its precipitation input must be on a regular lat/lon or a rotated-pole grid, and "other
# projections are not handled". That is a hard interface requirement over a small enumerable set,
# which is the definition of something that should be terms rather than the prose the schema's
# catch-all branch would otherwise give it.
#
# Each term carries the CF-conventions `grid_mapping_name` as its skos:notation. CF is what the
# climate datasets in question (E-OBS, NUKLEUS, EURO-CORDEX) actually declare, so a consumer can
# read a candidate NetCDF's grid_mapping variable and check membership without a human in the
# loop. Seeded with the two evidenced terms only; extending it for another projection is a lookup
# in the CF table rather than a judgement, which is why nothing else is pre-empted here.
#################################################################

focal-grid:scheme a skos:ConceptScheme ;
  skos:prefLabel "FOCAL Grid Types"@en ;
  skos:definition "Grid structures a workflow's gridded inputs may be on. Open; cross-walked to CF-conventions grid_mapping_name values."@en ;
  skos:hasTopConcept focal-grid:regular-latlon, focal-grid:rotated-pole ;
.

focal-grid:regular-latlon a skos:Concept ;
  skos:prefLabel "regular latitude/longitude grid"@en ;
  skos:notation "latitude_longitude" ;
  skos:definition "A grid whose axes are longitude and latitude in degrees, evenly spaced. The CF grid_mapping_name is latitude_longitude."@en ;
  skos:topConceptOf focal-grid:scheme ;
  skos:inScheme focal-grid:scheme ;
.

focal-grid:rotated-pole a skos:Concept ;
  skos:prefLabel "rotated-pole grid"@en ;
  skos:notation "rotated_latitude_longitude" ;
  skos:definition "A latitude/longitude grid on a rotated sphere, used by EURO-CORDEX (EUR-11) and the regional climate models driven by it, so that a limited-area domain is close to regular in its own coordinates. Its footprint in true lat/lon is not a rectangle. The CF grid_mapping_name is rotated_latitude_longitude."@en ;
  skos:topConceptOf focal-grid:scheme ;
  skos:inScheme focal-grid:scheme ;
.

#################################################################
# axes
#
# Axes an artifact's data must have, for acceptance criteria. Seeded with the one term the corpus
# evidences: UP-WF3's rolling accumulation needs a time axis, without which it has nothing to
# accumulate over. Deliberately not pre-populated with vertical, ensemble or the rest -- no FOCAL
# workflow states a requirement for one, and a scheme padded with plausible terms nobody asked for
# is a scheme nobody trusts the contents of.
#################################################################

focal-axis:scheme a skos:ConceptScheme ;
  skos:prefLabel "FOCAL Data Axes"@en ;
  skos:definition "Axes an artifact's data must carry for a workflow to accept it."@en ;
  skos:hasTopConcept focal-axis:time ;
.

focal-axis:time a skos:Concept ;
  skos:prefLabel "time"@en ;
  skos:definition "A time axis. Required by any workflow that aggregates, accumulates or composites over time rather than operating on a single field."@en ;
  skos:topConceptOf focal-axis:scheme ;
  skos:inScheme focal-axis:scheme ;
.

#################################################################
# scenario markers
#
# Previously a free string. Global Warming Levels are a small, well-known, enumerable set, and
# "non-free-text value" is exactly the case that should be a term: GWL+1.5 written two different
# ways by two pilots is two incomparable strings but one concept.
#################################################################

focal-marker:scheme a skos:ConceptScheme ;
  skos:prefLabel "FOCAL Scenario Markers"@en ;
  skos:definition "Non-calendar, scenario-indexed temporal positions. Seeded with the Global Warming Levels used in FOCAL's climate workflows; open, since other scenario indices (emissions pathways, SSP/RCP combinations) may follow."@en ;
  skos:hasTopConcept focal-marker:gwl-1.5, focal-marker:gwl-2.0, focal-marker:gwl-3.0 ;
.

focal-marker:gwl-1.5 a skos:Concept ;
  skos:prefLabel "Global Warming Level +1.5 °C"@en ;
  skos:notation "GWL+1.5" ;
  skos:definition "The point at which global mean surface temperature reaches 1.5 °C above pre-industrial levels. Not a calendar date: it is reached in different years under different emissions scenarios and ensemble members, which is why it cannot be expressed as a period."@en ;
  skos:topConceptOf focal-marker:scheme ;
  skos:inScheme focal-marker:scheme ;
.

focal-marker:gwl-2.0 a skos:Concept ;
  skos:prefLabel "Global Warming Level +2.0 °C"@en ;
  skos:notation "GWL+2.0" ;
  skos:topConceptOf focal-marker:scheme ;
  skos:inScheme focal-marker:scheme ;
.

focal-marker:gwl-3.0 a skos:Concept ;
  skos:prefLabel "Global Warming Level +3.0 °C"@en ;
  skos:notation "GWL+3.0" ;
  skos:topConceptOf focal-marker:scheme ;
  skos:inScheme focal-marker:scheme ;
.

#################################################################
# Classes
#
# FOCAL mints a class only where nothing published says the same thing. Everything that has a
# well-known equivalent uses it directly instead: geometry is geo:Geometry, a period is
# dcterms:PeriodOfTime, an artifact is a prov:Entity, a quality annotation is a
# dqv:QualityAnnotation. Those are not FOCAL terms with mappings bolted on; they are the terms
# used, so a consumer that already understands GeoSPARQL, DCAT, PROV or DQV needs to learn
# nothing about FOCAL to act on that part of the graph.
#################################################################

focal-transf:TransferabilityStatement a owl:Class ;
  rdfs:label "Transferability Statement"@en ;
  rdfs:comment "The portability boundary of something: where its results are valid, which reference or calibration artifacts it depends on, and what must happen to each to make the results valid elsewhere."@en ;
.

focal-transf:EnvelopeConstraint a owl:Class ;
  rdfs:label "Envelope Constraint"@en ;
  rdfs:comment "One role/dimension/value statement bounding where results are valid. No published vocabulary carries this: dcterms:spatial and dcterms:temporal state a single coverage, whereas the distinction that matters here is between what a workflow was trained on, what its outputs are valid for, and where it can technically run -- three different extents that come apart in practice."@en ;
.

focal-transf:ArtifactDependency a owl:Class ;
  rdfs:label "Artifact Dependency"@en ;
  rdfs:comment "A reference or calibration artifact a workflow depends on, as it is described for transferability purposes."@en ;
  rdfs:subClassOf prov:Entity ;
.

focal-transf:AcceptanceCriteria a owl:Class ;
  rdfs:label "Acceptance Criteria"@en ;
  rdfs:comment "What a dataset must satisfy to serve as a given artifact. A standing property of the interface rather than of any transfer: the requirement holds whether or not the workflow is being moved, and merely becomes visible when a substitution is proposed. It is what turns focal-action:replace-with-local-equivalent from an instruction that something must change into one a consumer can check a candidate dataset against."@en ;
.

focal-transf:Rule a owl:Class ;
  rdfs:label "Transferability Rule"@en ;
  rdfs:comment "A condition/action rule: which artifacts it governs, the envelope conditions under which it fires, the actions that resolve it, and whether applying one is mandatory."@en ;
.

focal-transf:Condition a owl:Class ;
  rdfs:label "Envelope Condition"@en ;
  rdfs:comment "One test of a target against one envelope constraint. Conditions on a rule are conjunctive: all of them must hold for the rule to fire."@en ;
.

#################################################################
# Properties
#
# The `.../transferability/properties/` namespace is used by every context.jsonld in this group.
# Each property below either is declared here as genuinely FOCAL-specific, or is absent because
# the model uses a published property directly. The reused ones, for reference:
#
#   artifact label      -> dcterms:title
#   free-text notes     -> rdfs:comment
#   geometry            -> geo:Geometry / geo:asWKT
#   calendar period     -> dcterms:PeriodOfTime / dcat:startDate / dcat:endDate
#   quality annotation  -> dqv:QualityAnnotation / dqv:inDimension (the attaching property is
#                          FOCAL's; see focal-prop:qualityAnnotation for why)
#   artifact entity     -> prov:Entity
#   unit                -> qudt:Unit (QUDT unit IRIs)
#   schema conformance  -> dcterms:conformsTo
#
# Where a property's values are drawn from one of the schemes above, that is stated as an OWL
# range restriction (`rdfs:range [ owl:onProperty skos:inScheme ; owl:hasValue <scheme> ]`) rather
# than by putting skos:inScheme on the property itself. The latter reads as "this property is a
# concept in that scheme", which is not true of any property here and would have a reasoner
# concluding that focal-prop:role is one of the roles.
#################################################################

focal-prop:transferability a owl:ObjectProperty ;
  rdfs:label "transferability"@en ;
  rdfs:comment "Attaches a transferability statement to the thing it describes."@en ;
  rdfs:range focal-transf:TransferabilityStatement ;
.

focal-prop:envelope a owl:ObjectProperty ;
  rdfs:label "envelope"@en ;
  rdfs:comment "One statement of the validity envelope. Repeatable: roles and dimensions are independent axes, so several can apply at once."@en ;
  rdfs:domain focal-transf:TransferabilityStatement ;
  rdfs:range focal-transf:EnvelopeConstraint ;
.

focal-prop:artifacts a owl:ObjectProperty ;
  rdfs:label "artifacts"@en ;
  rdfs:comment "A reference or calibration artifact this statement's rules may govern. Declared once and cited by rules, so an artifact constrained on two axes, or four artifacts sharing one boundary, are both expressible without repetition."@en ;
  rdfs:domain focal-transf:TransferabilityStatement ;
  rdfs:range focal-transf:ArtifactDependency ;
.

focal-prop:rules a owl:ObjectProperty ;
  rdfs:label "rules"@en ;
  rdfs:comment "A condition/action rule. An empty set is a positive statement -- assessed, nothing needs adapting -- and is not the same as the property being absent, which says nobody has looked."@en ;
  rdfs:domain focal-transf:TransferabilityStatement ;
  rdfs:range focal-transf:Rule ;
.

focal-prop:role a owl:ObjectProperty ;
  rdfs:label "role"@en ;
  rdfs:comment "Which aspect of the envelope this statement describes: what the workflow was trained on, what its results are valid for, or where it can technically run."@en ;
  rdfs:domain focal-transf:EnvelopeConstraint ;
  rdfs:range skos:Concept ;
  rdfs:range [ a owl:Restriction ; owl:onProperty skos:inScheme ; owl:hasValue focal-role:scheme ] ;
.

focal-prop:dimension a owl:ObjectProperty ;
  rdfs:label "dimension"@en ;
  rdfs:comment "Which axis of variation this statement constrains. Also decides the shape of the value, and therefore whether a machine can evaluate a condition against it."@en ;
  rdfs:domain focal-transf:EnvelopeConstraint ;
  rdfs:range skos:Concept ;
  rdfs:range [ a owl:Restriction ; owl:onProperty skos:inScheme ; owl:hasValue focal-dim:scheme ] ;
.

focal-prop:value a rdf:Property ;
  rdfs:label "value"@en ;
  rdfs:comment "The constraint value. A geo:Geometry for spatial and jurisdictional dimensions, a dcterms:PeriodOfTime or a scenario-marker concept for temporal, a plain string otherwise. Per-dimension constraints are in the block's shapes.shacl."@en ;
  rdfs:domain focal-transf:EnvelopeConstraint ;
.

focal-prop:scenarioMarker a owl:ObjectProperty ;
  rdfs:label "scenario marker"@en ;
  rdfs:comment "A non-calendar, scenario-indexed temporal position, for results that are not calendar-indexed at all."@en ;
  rdfs:range skos:Concept ;
  rdfs:range [ a owl:Restriction ; owl:onProperty skos:inScheme ; owl:hasValue focal-marker:scheme ] ;
.

focal-prop:artifactRole a owl:ObjectProperty ;
  rdfs:label "artifact role"@en ;
  rdfs:comment "What kind of thing the artifact is, independent of whether an executable workflow description exists that could give it an identifier yet."@en ;
  rdfs:domain focal-transf:ArtifactDependency ;
  rdfs:range skos:Concept ;
  rdfs:range [ a owl:Restriction ; owl:onProperty skos:inScheme ; owl:hasValue focal-arole:scheme ] ;
.

focal-prop:artifactRef a owl:DatatypeProperty ;
  rdfs:label "artifact reference"@en ;
  rdfs:comment "JSON Pointer (RFC 6901) locating the artifact within the document this statement annotates."@en ;
  rdfs:domain focal-transf:ArtifactDependency ;
  rdfs:range xsd:string ;
.

focal-prop:appliesTo a owl:ObjectProperty ;
  rdfs:label "applies to"@en ;
  rdfs:comment "An artifact this rule governs. A rule with no artifact applies to the workflow as a whole."@en ;
  rdfs:domain focal-transf:Rule ;
  rdfs:range focal-transf:ArtifactDependency ;
.

focal-prop:when a owl:ObjectProperty ;
  rdfs:label "when"@en ;
  rdfs:comment "A condition that must hold for this rule to fire. Conditions are conjunctive: all of them must hold. A disjunction is written as separate rules, which keeps each one traceable to the statement it came from."@en ;
  rdfs:domain focal-transf:Rule ;
  rdfs:range focal-transf:Condition ;
.

focal-prop:constraint a owl:ObjectProperty ;
  rdfs:label "constraint"@en ;
  rdfs:comment "The envelope constraint this condition tests the target against."@en ;
  rdfs:domain focal-transf:Condition ;
  rdfs:range focal-transf:EnvelopeConstraint ;
.

focal-prop:test a owl:ObjectProperty ;
  rdfs:label "test"@en ;
  rdfs:comment "How the target is compared against the constraint."@en ;
  rdfs:domain focal-transf:Condition ;
  rdfs:range skos:Concept ;
  rdfs:range [ a owl:Restriction ; owl:onProperty skos:inScheme ; owl:hasValue focal-test:scheme ] ;
.

focal-prop:classificationScheme a owl:ObjectProperty ;
  rdfs:label "classification scheme"@en ;
  rdfs:comment "The published classification system an analogy constraint is evaluated in."@en ;
  rdfs:range skos:Concept ;
  rdfs:range [ a owl:Restriction ; owl:onProperty skos:inScheme ; owl:hasValue focal-cls:scheme ] ;
.

focal-prop:sameClassAs a owl:ObjectProperty ;
  rdfs:label "same class as"@en ;
  rdfs:comment "The reference whose classification the target must share, normally another envelope constraint in the same statement (typically the trained-on extent). Naming a reference rather than a class list is what lets the class set be derived, and re-derived when the reference geometry is corrected."@en ;
  rdfs:range focal-transf:EnvelopeConstraint ;
.

focal-prop:class a owl:ObjectProperty ;
  rdfs:label "class"@en ;
  rdfs:comment "An explicitly stated class of the constraint's classification scheme. Use only where the source states classes; otherwise name a reference with focal-prop:sameClassAs and let them be derived. Values are terms of the external scheme, cited by its own identifiers where it has them."@en ;
.

focal-prop:termNamespace a owl:ObjectProperty ;
  rdfs:label "term namespace"@en ;
  rdfs:comment "Where an external classification scheme's own term identifiers live, for schemes that publish dereferenceable terms. Absent for schemes distributed as data rather than as a vocabulary."@en ;
  rdfs:domain skos:Concept ;
.

focal-prop:sameAsCurrent a owl:DatatypeProperty ;
  rdfs:label "same as current"@en ;
  rdfs:comment "Asserts that a criterion's required value is whatever the artifact currently in use has, rather than a literal. The honest encoding of a source that says 'the same variable name as the current dataset' without naming it: the requirement is a relation, and recording a guessed literal in its place states something the source did not."@en ;
  rdfs:range xsd:boolean ;
.

focal-prop:triggeredBy a owl:ObjectProperty ;
  rdfs:label "triggered by"@en ;
  rdfs:comment "A coarse, human-readable statement of what fires this rule, for cases where no envelope constraint can be cited. Where one can, focal-prop:when says the same thing precisely and machine-evaluably."@en ;
  rdfs:domain focal-transf:Rule ;
  rdfs:range skos:Concept ;
  rdfs:range [ a owl:Restriction ; owl:onProperty skos:inScheme ; owl:hasValue focal-trigger:scheme ] ;
.

focal-prop:actions a owl:ObjectProperty ;
  rdfs:label "actions"@en ;
  rdfs:comment "An OR-set: any one of these actions resolves the rule. Never a sequence, and never a combination to apply together."@en ;
  rdfs:domain focal-transf:Rule ;
  rdfs:range skos:Concept ;
  rdfs:range [ a owl:Restriction ; owl:onProperty skos:inScheme ; owl:hasValue focal-action:scheme ] ;
.

focal-prop:mandatory a owl:DatatypeProperty ;
  rdfs:label "mandatory"@en ;
  rdfs:comment "Whether applying one of the rule's actions is mandatory once its conditions hold. False means the workflow still runs, with degraded result quality or trust described in the rule's rdfs:comment."@en ;
  rdfs:domain focal-transf:Rule ;
  rdfs:range xsd:boolean ;
.

focal-prop:acceptanceCriteria a owl:ObjectProperty ;
  rdfs:label "acceptance criteria"@en ;
  rdfs:comment "Attaches acceptance criteria to the artifact they describe."@en ;
  rdfs:domain focal-transf:ArtifactDependency ;
  rdfs:range focal-transf:AcceptanceCriteria ;
.

focal-prop:variable a owl:DatatypeProperty ;
  rdfs:label "variable"@en ;
  rdfs:comment "The name the workflow expects a variable to be called. Deliberately a plain string and not a CF standard name: a standard name is a claim about what a quantity is, whereas this is a claim about what this workflow's code looks for, and the two coincide only by convention."@en ;
  rdfs:domain focal-transf:AcceptanceCriteria ;
  rdfs:range xsd:string ;
.

focal-prop:unit a owl:ObjectProperty ;
  rdfs:label "unit"@en ;
  rdfs:comment "A unit the variable may be in, as a QUDT unit. Repeatable and disjunctive: any one listed is acceptable. QUDT rather than a unit string because mm, millimetre and mm/day are three incomparable strings and the last is a different quantity; a QUDT unit carries its symbol and its quantity kind, so conformance is decidable."@en ;
  rdfs:domain focal-transf:AcceptanceCriteria ;
  rdfs:range qudt:Unit ;
.

focal-prop:axis a owl:ObjectProperty ;
  rdfs:label "axis"@en ;
  rdfs:comment "An axis the data must have. Repeatable and conjunctive, unlike focal-prop:unit and focal-prop:gridType: every axis listed must be present."@en ;
  rdfs:domain focal-transf:AcceptanceCriteria ;
  rdfs:range skos:Concept ;
  rdfs:range [ a owl:Restriction ; owl:onProperty skos:inScheme ; owl:hasValue focal-axis:scheme ] ;
.

focal-prop:gridType a owl:ObjectProperty ;
  rdfs:label "grid type"@en ;
  rdfs:comment "A grid structure gridded data may be on. Repeatable and disjunctive: the accepted set is the whole list. Used in two places for two jobs -- on an envelope constraint of dimension grid-structure it is a boundary a rule is conditioned on, and in acceptance criteria it is a specification a candidate dataset is checked against once a rule has fired."@en ;
  rdfs:range skos:Concept ;
  rdfs:range [ a owl:Restriction ; owl:onProperty skos:inScheme ; owl:hasValue focal-grid:scheme ] ;
.

focal-prop:affects a owl:DatatypeProperty ;
  rdfs:label "affects"@en ;
  rdfs:comment "A part of the annotated document whose availability this rule's outcome bears on, as a JSON Pointer -- typically a step or an output. It is what turns focal-action:component-not-executable from a claim with no object into one a consumer can act on: without it, 'a component cannot run' cannot be told apart from 'the workflow cannot run', and no per-workflow verdict can be assembled from per-artifact rules."@en ;
  rdfs:domain focal-transf:Rule ;
  rdfs:range xsd:string ;
.

focal-prop:qualityAnnotation a owl:ObjectProperty ;
  rdfs:label "quality annotation"@en ;
  rdfs:comment "Attaches an uncertainty or confidence statement to the thing it is about. FOCAL's own property rather than dqv:hasQualityAnnotation, whose domain is a dcat:Dataset or dcat:Distribution: a CWL Workflow is neither, and asserting DQV's property on one would have a reasoner conclude it is a dataset. The annotation node it points at is DQV's, carrying dqv:inDimension."@en ;
  rdfs:range dqv:QualityAnnotation ;
.

focal-prop:note a owl:DatatypeProperty ;
  rdfs:label "note"@en ;
  rdfs:comment "The text of a quality annotation, in the workflow owner's own words. Kept as a FOCAL property: DQV carries an annotation body through oa:hasBody, which is heavier machinery than a single sentence needs. Distinct from rdfs:comment, which every other free-text note in this model uplifts to -- this one is the annotation's payload, not a remark about it."@en ;
  rdfs:domain dqv:QualityAnnotation ;
  rdfs:range xsd:string ;
.

focal-prop:computationType a owl:ObjectProperty ;
  rdfs:label "computation type"@en ;
  rdfs:comment "How the workflow computes its results."@en ;
  rdfs:range skos:Concept ;
  rdfs:range [ a owl:Restriction ; owl:onProperty skos:inScheme ; owl:hasValue focal-compute:scheme ] ;
.

focal-prop:maturityStatus a owl:ObjectProperty ;
  rdfs:label "maturity status"@en ;
  rdfs:comment "The workflow's operational maturity stage. Distinct from a Block's own authoring-lifecycle status, and from dqv quality: a workflow can be operational and still carry a result-confidence caveat."@en ;
  rdfs:range skos:Concept ;
  rdfs:range [ a owl:Restriction ; owl:onProperty skos:inScheme ; owl:hasValue focal-maturity:scheme ] ;
.

#################################################################
# koppen-geiger
#
# FOCAL publishes this scheme because nobody else does. Koppen-Geiger is distributed as raster
# datasets (Beck et al. 2018 and successors) and as prose in textbooks; there is no maintained SKOS
# vocabulary and its classes therefore have no identifiers anything can cite. That is a gap, not a
# territory somebody else occupies, and the distinction is the whole rule: FOCAL never restates a
# vocabulary that has a maintainer (EUNIS habitats, QUDT units, DQV dimensions, CF grid mappings
# are all referenced, never copied), and does publish one where a stable, closed, universally
# agreed set has simply never been given identifiers. The 30 classes below have been unchanged for
# decades and are not FOCAL's invention -- only their IRIs are.
#
# This scheme stays in FOCAL, identifiers included, by decision. A climate classification is
# arguably a poor fit for a project register, and if this is ever refactored into a cross-domain
# one the tier moves with it -- at the cost of either changing IRIs that consumers may have cited,
# or leaving FOCAL-namespaced IRIs in a register that is not FOCAL's. Taken deliberately.
#
# The two-level hierarchy is deliberate and load-bearing for `same-class-as`: whether Cfb and Cfa
# count as "a comparable ecological range" is a real question, and skos:broader lets a consumer
# evaluate the analogy at either granularity instead of forcing the finest one. Which level a given
# constraint intends is a question for its owner.
#################################################################

focal-koppen:scheme a skos:ConceptScheme ;
  skos:prefLabel "Koppen-Geiger climate classification"@en ;
  skos:definition "The Koppen-Geiger empirical climate classification, in the 30-class form used by modern high-resolution global maps. Published here with identifiers because the scheme itself has none; the classes and their meanings are long-established and not FOCAL's."@en ;
  dcterms:source <https://doi.org/10.1038/sdata.2018.214> ;
  skos:hasTopConcept focal-koppen:A, focal-koppen:B, focal-koppen:C, focal-koppen:D, focal-koppen:E ;
.


focal-koppen:A a skos:Concept ;
  skos:prefLabel "Tropical"@en ;
  skos:notation "A" ;
  skos:topConceptOf focal-koppen:scheme ;
  skos:inScheme focal-koppen:scheme ;
.

focal-koppen:B a skos:Concept ;
  skos:prefLabel "Arid"@en ;
  skos:notation "B" ;
  skos:topConceptOf focal-koppen:scheme ;
  skos:inScheme focal-koppen:scheme ;
.

focal-koppen:C a skos:Concept ;
  skos:prefLabel "Temperate"@en ;
  skos:notation "C" ;
  skos:topConceptOf focal-koppen:scheme ;
  skos:inScheme focal-koppen:scheme ;
.

focal-koppen:D a skos:Concept ;
  skos:prefLabel "Cold (continental)"@en ;
  skos:notation "D" ;
  skos:topConceptOf focal-koppen:scheme ;
  skos:inScheme focal-koppen:scheme ;
.

focal-koppen:E a skos:Concept ;
  skos:prefLabel "Polar"@en ;
  skos:notation "E" ;
  skos:topConceptOf focal-koppen:scheme ;
  skos:inScheme focal-koppen:scheme ;
.

focal-koppen:Af a skos:Concept ;
  skos:prefLabel "Tropical rainforest"@en ;
  skos:notation "Af" ;
  skos:broader focal-koppen:A ;
  skos:inScheme focal-koppen:scheme ;
.

focal-koppen:Am a skos:Concept ;
  skos:prefLabel "Tropical monsoon"@en ;
  skos:notation "Am" ;
  skos:broader focal-koppen:A ;
  skos:inScheme focal-koppen:scheme ;
.

focal-koppen:Aw a skos:Concept ;
  skos:prefLabel "Tropical savannah"@en ;
  skos:notation "Aw" ;
  skos:broader focal-koppen:A ;
  skos:inScheme focal-koppen:scheme ;
.

focal-koppen:BWh a skos:Concept ;
