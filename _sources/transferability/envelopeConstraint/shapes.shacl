@prefix sh:          <http://www.w3.org/ns/shacl#> .
@prefix skos:        <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .
@prefix geo:         <http://www.opengis.net/ont/geosparql#> .
@prefix dcat:        <http://www.w3.org/ns/dcat#> .
@prefix focal-prop:  <https://w3id.org/ogc/hosted/focal/transferability/properties/> .
@prefix focal-shape: <https://w3id.org/ogc/hosted/focal/transferability/shapes/> .

#################################################################
# Shapes for FOCAL envelope constraints only. Nothing here touches CWL.
#
# Targeted by property, since the uplift emits nodes with no rdf:type. Vocabulary-membership
# checks are sh:Warning: these schemes are open, so an unrecognised term is a prompt to extend
# transferability/vocab rather than malformed data -- though the postprocessor currently fails an
# example on any SHACL result, warnings included.
#################################################################

focal-shape:EnvelopeConstraint
  a sh:NodeShape ;
  sh:targetObjectsOf focal-prop:envelope ;
  sh:targetSubjectsOf focal-prop:dimension ;

  sh:property [
    sh:path focal-prop:role ;
    sh:name "role" ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class skos:Concept ;
    sh:severity sh:Warning ;
    sh:message "role must be exactly one concept from the FOCAL envelope-roles scheme (trained-on, valid-for, can-run-on, ...)." ;
  ] ;

  sh:property [
    sh:path focal-prop:dimension ;
    sh:name "dimension" ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class skos:Concept ;
    sh:severity sh:Warning ;
    sh:message "dimension must be exactly one concept from the FOCAL envelope-dimensions scheme. The scheme is open, so a genuinely new axis is fine -- but add it to transferability/vocab, because from the data side a new axis and a misspelling look identical." ;
  ] ;

  sh:property [
    sh:path focal-prop:value ;
    sh:name "value" ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "every envelope constraint states exactly one value." ;
  ] ;

  sh:property [
    sh:path rdfs:comment ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
.

#################################################################
# Per-dimension value shapes: the RDF-side counterpart of the schema's oneOf branches.
#
# Not redundant with it. Uplifted data can reach a triplestore without passing through the schema,
# and these checks depend on a sibling property's value, which JSON Schema expresses only awkwardly
# and SPARQL expresses directly.
#################################################################

focal-shape:SpatialEnvelopeValue
  a sh:NodeShape ;
  sh:targetSubjectsOf focal-prop:dimension ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "a spatial or jurisdictional constraint's value must be a geometry carrying geo:asWKT. A free-text place name is not an alternative: the point of this dimension is that a GeoSPARQL engine can test an area of interest against it with geof:sfWithin." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://w3id.org/ogc/hosted/focal/transferability/properties/dimension> ?dim .
        FILTER(?dim IN (
          <https://w3id.org/ogc/hosted/focal/transferability/dimensions/spatial>,
          <https://w3id.org/ogc/hosted/focal/transferability/dimensions/jurisdictional>
        ))
        $this <https://w3id.org/ogc/hosted/focal/transferability/properties/value> ?v .
        FILTER NOT EXISTS { ?v <http://www.opengis.net/ont/geosparql#asWKT> ?wkt }
      }
    """ ;
  ] ;
.

focal-shape:TemporalEnvelopeValue
  a sh:NodeShape ;
  sh:targetSubjectsOf focal-prop:dimension ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "a temporal constraint's value must be either a calendar period (dcat:startDate and dcat:endDate) or a scenario marker, and not both. A Global Warming Level is not a calendar date -- it is reached in different years under different scenarios -- which is why the marker shape exists instead of forcing one." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://w3id.org/ogc/hosted/focal/transferability/properties/dimension>
              <https://w3id.org/ogc/hosted/focal/transferability/dimensions/temporal> .
        $this <https://w3id.org/ogc/hosted/focal/transferability/properties/value> ?v .
        OPTIONAL { ?v <http://www.w3.org/ns/dcat#startDate> ?s }
        OPTIONAL { ?v <http://www.w3.org/ns/dcat#endDate> ?e }
        OPTIONAL { ?v <https://w3id.org/ogc/hosted/focal/transferability/properties/scenarioMarker> ?m }
        FILTER(
          ( !BOUND(?m) && ( !BOUND(?s) || !BOUND(?e) ) )
          || ( BOUND(?m) && ( BOUND(?s) || BOUND(?e) ) )
        )
      }
    """ ;
  ] ;
.

focal-shape:GridStructureEnvelopeValue
  a sh:NodeShape ;
  sh:targetSubjectsOf focal-prop:dimension ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "a grid-structure constraint's value must list at least one accepted grid type. The set is the constraint: `inside` means the target's grid is a member of it, which is a check a consumer can run against a CF grid_mapping_name without a human in the loop -- and cannot run against a sentence describing the same requirement." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://w3id.org/ogc/hosted/focal/transferability/properties/dimension>
              <https://w3id.org/ogc/hosted/focal/transferability/dimensions/grid-structure> .
        $this <https://w3id.org/ogc/hosted/focal/transferability/properties/value> ?v .
        FILTER NOT EXISTS { ?v <https://w3id.org/ogc/hosted/focal/transferability/properties/gridType> ?g }
      }
    """ ;
  ] ;
.

focal-shape:GridTypeIsAConcept
  a sh:NodeShape ;
  sh:targetObjectsOf focal-prop:value ;
  sh:property [
    sh:path focal-prop:gridType ;
    sh:name "gridTypes" ;
    sh:nodeKind sh:IRI ;
    sh:class skos:Concept ;
    sh:severity sh:Warning ;
    sh:message "a grid type should resolve to a concept in the FOCAL grid-types scheme (regular-latlon, rotated-pole, ...). The scheme is open and cross-walked to CF grid_mapping_name, so a projection nobody has added yet is a vocabulary gap to fill rather than malformed data." ;
  ] ;
.

focal-shape:NonGeometricEnvelopeValue
  a sh:NodeShape ;
  sh:targetSubjectsOf focal-prop:dimension ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "a constraint on any dimension the schema gives no structured shape to carries a plain string value. A phenological regime is not a place, and wrapping it in coordinates it does not have makes the data less honest, not more machine-readable." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://w3id.org/ogc/hosted/focal/transferability/properties/dimension> ?dim .
        FILTER(?dim NOT IN (
          <https://w3id.org/ogc/hosted/focal/transferability/dimensions/spatial>,
          <https://w3id.org/ogc/hosted/focal/transferability/dimensions/jurisdictional>,
          <https://w3id.org/ogc/hosted/focal/transferability/dimensions/temporal>,
          <https://w3id.org/ogc/hosted/focal/transferability/dimensions/grid-structure>
        ))
        $this <https://w3id.org/ogc/hosted/focal/transferability/properties/value> ?v .
        FILTER(!isLiteral(?v))
      }
    """ ;
  ] ;
.

#################################################################
# A scenario marker is a concept, not a string.
#
# GWL+1.5 written two ways by two pilots is two incomparable strings but one concept, which is
# exactly the case a controlled vocabulary exists for.
#################################################################

focal-shape:ScenarioMarkerIsAConcept
  a sh:NodeShape ;
  sh:targetObjectsOf focal-prop:value ;
  sh:property [
    sh:path focal-prop:scenarioMarker ;
    sh:name "scenarioMarker" ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class skos:Concept ;
    sh:severity sh:Warning ;
    sh:message "scenarioMarker should resolve to a concept in the FOCAL scenario-markers scheme (gwl-1.5, gwl-2.0, gwl-3.0, ...)." ;
  ] ;
.
