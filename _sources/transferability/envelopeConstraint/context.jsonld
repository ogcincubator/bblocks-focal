{
  "@context": {
    "focal-transf-prop": "https://w3id.org/ogc/hosted/focal/transferability/properties/",
    "geo": "http://www.opengis.net/ont/geosparql#",
    "dcterms": "http://purl.org/dc/terms/",
    "dcat": "http://www.w3.org/ns/dcat#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "id": "@id",
    "role": {
      "@id": "focal-transf-prop:role",
      "@type": "@id",
      "@context": { "@base": "https://w3id.org/ogc/hosted/focal/transferability/roles/" }
    },
    "dimension": {
      "@id": "focal-transf-prop:dimension",
      "@type": "@id",
      "@context": { "@base": "https://w3id.org/ogc/hosted/focal/transferability/dimensions/" }
    },
    "value": {
      "@id": "focal-transf-prop:value",
      "@context": {
        "asWKT": { "@id": "geo:asWKT", "@type": "geo:wktLiteral" },
        "startDate": "dcat:startDate",
        "endDate": "dcat:endDate",
        "scenarioMarker": {
          "@id": "focal-transf-prop:scenarioMarker",
          "@type": "@id",
          "@context": { "@base": "https://w3id.org/ogc/hosted/focal/transferability/scenario-markers/" }
        }
      }
    },
    "transferabilityNotes": "rdfs:comment"
  }
}
