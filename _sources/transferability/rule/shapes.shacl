@prefix sh:          <http://www.w3.org/ns/shacl#> .
@prefix skos:        <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .
@prefix focal-prop:  <https://w3id.org/ogc/hosted/focal/transferability/properties/> .
@prefix focal-shape: <https://w3id.org/ogc/hosted/focal/transferability/shapes/> .

#################################################################
# Shapes for FOCAL transferability rules only. Nothing here touches CWL.
#
# Targeted by property rather than by class: the uplift emits untyped nodes, and focal-prop:actions
# is unique to a rule, so it identifies one whether nested in a statement or standing alone.
#
# Vocabulary-membership checks are sh:Warning, since these schemes are open -- a term nobody has
# added yet is a prompt to extend transferability/vocab, not malformed data. Note the postprocessor
# currently fails an example on any SHACL result, warnings included, so in practice they bite.
#################################################################

focal-shape:TransferabilityRule
  a sh:NodeShape ;
  sh:targetSubjectsOf focal-prop:actions ;
  sh:targetObjectsOf focal-prop:rules ;

  sh:property [
    sh:path focal-prop:actions ;
    sh:name "actions" ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "a rule states at least one action. An action set is an OR-set: any one member resolves the rule, they are not applied together." ;
  ] ;

  sh:property [
    sh:path focal-prop:actions ;
    sh:class skos:Concept ;
    sh:severity sh:Warning ;
    sh:message "an action should resolve to a concept in the FOCAL actions scheme (reuse-as-is, replace-with-local-equivalent, retrain, replace-with-alternative-published-model, component-not-executable, ...)." ;
  ] ;

  sh:property [
    sh:path focal-prop:triggeredBy ;
    sh:name "triggeredBy" ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class skos:Concept ;
    sh:severity sh:Warning ;
    sh:message "triggeredBy should resolve to a concept in the FOCAL triggers scheme. Prefer `when`, which names the envelope constraint and is machine-evaluable; triggeredBy is the fallback for cases where no constraint can be cited." ;
  ] ;

  sh:property [
    sh:path focal-prop:mandatory ;
    sh:name "mandatory" ;
    sh:maxCount 1 ;
    sh:datatype xsd:boolean ;
    sh:message "mandatory is a single boolean; it defaults to true when absent." ;
  ] ;

  sh:property [
    sh:path focal-prop:affects ;
    sh:name "affects" ;
    sh:datatype xsd:string ;
    sh:pattern "^/" ;
    sh:message "affects entries are JSON Pointers (RFC 6901) into the annotated document and therefore start with '/'." ;
  ] ;

  sh:property [
    sh:path focal-prop:when ;
    sh:name "when" ;
    sh:node focal-shape:EnvelopeCondition ;
  ] ;
.

#################################################################
# A terminal outcome has to say what stops working.
#
# component-not-executable without `affects` names no component. That collapses "this step cannot
# run" into "the workflow cannot run", which are very different answers to give someone asking
# whether they can use the workflow over their area of interest -- and the difference is exactly
# what a per-workflow verdict has to be assembled from. UP-WF2 loses one step to CLMS, not the run.
#
# Warning rather than violation: a rule whose terminal outcome genuinely is the whole workflow is
# real, and saying so by omission is defensible until there is a document with steps to point at.
#################################################################

focal-shape:TerminalActionNamesWhatItAffects
  a sh:NodeShape ;
  sh:targetSubjectsOf focal-prop:actions ;
  sh:severity sh:Warning ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "a rule offering component-not-executable does not say which component: name the affected steps or outputs in `affects`, or state deliberately that the whole workflow is what stops." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://w3id.org/ogc/hosted/focal/transferability/properties/actions>
              <https://w3id.org/ogc/hosted/focal/transferability/actions/component-not-executable> .
        FILTER NOT EXISTS { $this <https://w3id.org/ogc/hosted/focal/transferability/properties/affects> ?a }
      }
    """ ;
  ] ;
.

focal-shape:EnvelopeCondition
  a sh:NodeShape ;
  sh:targetObjectsOf focal-prop:when ;

  sh:property [
    sh:path focal-prop:constraint ;
    sh:name "constraint" ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "a condition tests exactly one envelope constraint, cited by its id." ;
  ] ;

  sh:property [
    sh:path focal-prop:test ;
    sh:name "test" ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class skos:Concept ;
    sh:severity sh:Warning ;
    sh:message "test should resolve to a concept in the FOCAL condition-tests scheme (inside, outside)." ;
  ] ;
.

#################################################################
# Every rule states a condition.
#
# `when` is preferred and machine-evaluable; `triggeredBy` is the coarse fallback for cases where
# no envelope constraint can be cited without inventing one. Neither is individually required, but
# a rule with no stated condition at all fires unconditionally, which no evidenced case means.
#################################################################

focal-shape:RuleHasACondition
  a sh:NodeShape ;
  sh:targetSubjectsOf focal-prop:actions ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "a rule must state when it fires, either as `when` citing an envelope constraint (preferred) or as a coarse `triggeredBy` term." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://w3id.org/ogc/hosted/focal/transferability/properties/actions> ?a .
        FILTER NOT EXISTS { $this <https://w3id.org/ogc/hosted/focal/transferability/properties/when> ?w }
        FILTER NOT EXISTS { $this <https://w3id.org/ogc/hosted/focal/transferability/properties/triggeredBy> ?t }
      }
    """ ;
  ] ;
.

#################################################################
# A non-mandatory rule has to say what is lost by skipping it.
#
# The difference between "runs anyway, treat results as exploratory" and "runs anyway" full stop is
# the whole value of the flag to anyone deciding whether to trust an output. FP-WF3 is the
# evidenced case. Enforced hard, unlike the vocabulary checks.
#################################################################

focal-shape:OptionalRuleHasConsequence
  a sh:NodeShape ;
  sh:targetSubjectsOf focal-prop:mandatory ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "a rule with mandatory=false must describe the consequence of skipping it in transferabilityNotes: what degrades, and how far the results can still be trusted." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://w3id.org/ogc/hosted/focal/transferability/properties/mandatory> false .
        FILTER NOT EXISTS { $this <http://www.w3.org/2000/01/rdf-schema#comment> ?n }
      }
    """ ;
  ] ;
.

#################################################################
# component-not-executable is terminal.
#
# It means no substitute exists and the component cannot run for the target. Pairing it with
# reuse-as-is in one OR-set claims both "works unchanged" and "cannot run", which is not a choice
# a consumer can act on. Pairing it with replace-with-local-equivalent is fine, and is UP-WF2's
# evidenced case: substitute if you can find one, otherwise this is where it ends.
#################################################################

focal-shape:TerminalActionNotAlongsideReuse
  a sh:NodeShape ;
  sh:targetSubjectsOf focal-prop:actions ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "component-not-executable and reuse-as-is contradict each other in the same OR-set: one says the artifact works unchanged, the other that the component cannot run at all." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://w3id.org/ogc/hosted/focal/transferability/properties/actions>
              <https://w3id.org/ogc/hosted/focal/transferability/actions/component-not-executable> ,
              <https://w3id.org/ogc/hosted/focal/transferability/actions/reuse-as-is> .
      }
    """ ;
  ] ;
.
