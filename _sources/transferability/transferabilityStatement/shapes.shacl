@prefix sh:          <http://www.w3.org/ns/shacl#> .
@prefix skos:        <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:     <http://purl.org/dc/terms/> .
@prefix focal-prop:  <https://w3id.org/ogc/hosted/focal/transferability/properties/> .
@prefix focal-shape: <https://w3id.org/ogc/hosted/focal/transferability/shapes/> .

#################################################################
# Shapes for the FOCAL transferability statement and its artifacts.
# Scoped strictly to FOCAL's own properties -- the CWL half of a workflow is not touched here.
#
# The referential-integrity shapes below are the ones that only became possible once envelope
# constraints and artifacts carry ids. They are what stops the id indirection from being a way to
# write dangling references: a rule that cites a constraint nobody declared used to be
# inexpressible because rules could not cite anything at all, and would now be silently ignored.
#################################################################

#################################################################
# Targeting note: a statement whose `envelope` or `rules` is the empty array emits no triple for
# that property, so targeting by any single one of them would switch these checks off for exactly
# the statements most likely to need them. Every statement-level shape below therefore targets the
# union of the three list properties plus the attachment property.
#
# There is deliberately no minimum on `envelope`. An empty one is a claim -- no validity boundary
# -- not an omission, and the schema's `required` on all three lists is what stops it from being
# read as an oversight.
#################################################################

focal-shape:TransferabilityStatement
  a sh:NodeShape ;
  sh:targetSubjectsOf focal-prop:envelope ;
  sh:targetSubjectsOf focal-prop:artifacts ;
  sh:targetSubjectsOf focal-prop:rules ;
  sh:targetObjectsOf focal-prop:transferability ;

  sh:property [
    sh:path rdfs:comment ;
    sh:name "transferabilityNotes" ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
.

focal-shape:ArtifactDependency
  a sh:NodeShape ;
  sh:targetObjectsOf focal-prop:artifacts ;

  sh:property [
    sh:path dcterms:title ;
    sh:name "artifact" ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
    sh:message "every artifact carries a label, in the words the source questionnaire used." ;
  ] ;

  sh:property [
    sh:path focal-prop:artifactRole ;
    sh:name "artifactRole" ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "every artifact is classified with exactly one role." ;
  ] ;

  sh:property [
    sh:path focal-prop:artifactRole ;
    sh:class skos:Concept ;
    sh:severity sh:Warning ;
    sh:message "artifactRole should resolve to a concept in the FOCAL artifact-roles scheme (workflow-input, workflow-output, external-resource, infrastructure, ...). The scheme is open, so a new kind of artifact is fine -- add it to transferability/vocab so it is a term rather than a string." ;
  ] ;

  sh:property [
    sh:path focal-prop:artifactRef ;
    sh:name "artifactRef" ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^/" ;
    sh:message "artifactRef is a JSON Pointer (RFC 6901) and therefore starts with '/'." ;
  ] ;
.

#################################################################
# A pointer only means something for an artifact inside the annotated document.
#
# external-resource and infrastructure are by definition outside it: an optional validation dataset
# the workflow only mentions, or a sensor network that has to be physically re-deployed. A pointer
# on either is a mistake about the role or a mistake about the pointer.
#################################################################

focal-shape:ArtifactRefOnlyForInternalRoles
  a sh:NodeShape ;
  sh:targetObjectsOf focal-prop:artifacts ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "artifactRef is only meaningful for the workflow-input and workflow-output roles; an external-resource or infrastructure artifact has nothing in the annotated document to point at." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://w3id.org/ogc/hosted/focal/transferability/properties/artifactRef> ?ref .
        $this <https://w3id.org/ogc/hosted/focal/transferability/properties/artifactRole> ?role .
        FILTER(?role IN (
          <https://w3id.org/ogc/hosted/focal/transferability/artifact-roles/external-resource>,
          <https://w3id.org/ogc/hosted/focal/transferability/artifact-roles/infrastructure>
        ))
      }
    """ ;
  ] ;
.

#################################################################
# Referential integrity: rules may only cite what the statement declares.
#################################################################

focal-shape:RuleCitesDeclaredConstraint
  a sh:NodeShape ;
  sh:targetSubjectsOf focal-prop:envelope ;
  sh:targetSubjectsOf focal-prop:artifacts ;
  sh:targetSubjectsOf focal-prop:rules ;
  sh:targetObjectsOf focal-prop:transferability ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "a rule cites an envelope constraint id that this statement does not declare in `envelope`. A dangling citation is silently unevaluable: nothing can test the target against a constraint that is not there." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://w3id.org/ogc/hosted/focal/transferability/properties/rules> ?rule .
        ?rule <https://w3id.org/ogc/hosted/focal/transferability/properties/when> ?cond .
        ?cond <https://w3id.org/ogc/hosted/focal/transferability/properties/constraint> ?cited .
        FILTER NOT EXISTS {
          $this <https://w3id.org/ogc/hosted/focal/transferability/properties/envelope> ?cited .
        }
      }
    """ ;
  ] ;
.

focal-shape:RuleCitesDeclaredArtifact
  a sh:NodeShape ;
  sh:targetSubjectsOf focal-prop:envelope ;
  sh:targetSubjectsOf focal-prop:artifacts ;
  sh:targetSubjectsOf focal-prop:rules ;
  sh:targetObjectsOf focal-prop:transferability ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "a rule applies to an artifact id that this statement does not declare in `artifacts`." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://w3id.org/ogc/hosted/focal/transferability/properties/rules> ?rule .
        ?rule <https://w3id.org/ogc/hosted/focal/transferability/properties/appliesTo> ?cited .
        FILTER NOT EXISTS {
          $this <https://w3id.org/ogc/hosted/focal/transferability/properties/artifacts> ?cited .
        }
      }
    """ ;
  ] ;
.

#################################################################
# An artifact nothing governs is probably an omission.
#
# Artifacts are listed because rules act on them. One that no rule cites either needs a rule, or
# does not belong in the statement -- but it may legitimately be waiting for one, so this is
# advisory rather than a violation.
#################################################################

focal-shape:ArtifactIsGovernedByARule
  a sh:NodeShape ;
  sh:targetSubjectsOf focal-prop:envelope ;
  sh:targetSubjectsOf focal-prop:artifacts ;
  sh:targetSubjectsOf focal-prop:rules ;
  sh:targetObjectsOf focal-prop:transferability ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:severity sh:Warning ;
    sh:message "an artifact is declared that no rule applies to. Either it needs a rule, or it does not need to be in the statement at all: only artifacts with an evidenced transferability fact belong here." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://w3id.org/ogc/hosted/focal/transferability/properties/artifacts> ?artifact .
        FILTER NOT EXISTS {
          $this <https://w3id.org/ogc/hosted/focal/transferability/properties/rules> ?rule .
          ?rule <https://w3id.org/ogc/hosted/focal/transferability/properties/appliesTo> ?artifact .
        }
      }
    """ ;
  ] ;
.
